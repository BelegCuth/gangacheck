# Configuración opcional para GangaCheck.es
# Deja estos valores vacíos para ejecutar en Modo Local (SQLite a coste 0 €)

# Servidor
HOST=0.0.0.0
PORT=8000

# Base de datos en la nube (Supabase - Opcional)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-publica

# Google Gemini API para extracción inteligente de especificaciones (Opcional - Gratuito en AI Studio)
GEMINI_API_KEY=tu-api-key-de-gemini
