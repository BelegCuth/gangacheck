# Panel de Administración (/admin)
ADMIN_USERNAME=admin@gangacheck.es
ADMIN_PASSWORD=GangaCheck2026!
ADMIN_SECRET_KEY=cambia-esta-clave-secreta-por-una-cadena-aleatoria-larga

# CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://gangacheck.es,https://www.gangacheck.es,https://gangacheck.onrender.com

