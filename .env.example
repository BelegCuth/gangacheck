# Configuración para GangaCheck.es
# Deja estos valores vacíos para ejecutar en Modo Local (SQLite a coste 0 €)

# Servidor
HOST=0.0.0.0
PORT=8000

# Base de datos en la nube (Supabase - Opcional)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-publica

# Google Gemini API para tasación inteligente de productos desconocidos (Opcional)
